# Copy this file to .env and fill in your values. NEVER commit .env (NFR-01).

# Google Gemini — the only approved LLM provider for this project.
# Get a free-tier key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Model selection (free-tier friendly). Override if needed.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Local embeddings fallback (open-source, no key needed) — used if USE_LOCAL_EMBEDDINGS=1
USE_LOCAL_EMBEDDINGS=1
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Runtime knobs
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
MEMORY_TTL_SECONDS=2592000
MEMORY_MAX_ITEMS=200

# Paths (relative to repo root)
CHECKPOINT_DB=checkpoints/graph_state.sqlite
MEMORY_DB=checkpoints/memory.sqlite
VECTORSTORE_DIR=data/vectorstore
